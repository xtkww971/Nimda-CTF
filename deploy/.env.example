# EC2 배포 폴더에 .env 로 복사해 채운다. 이 파일만 레포에 있고 .env 는 서버에만 둔다.
#   cp .env.example .env && chmod 600 .env

# Docker Hub 네임스페이스. CI 시크릿 DOCKER_HUB_USERNAME 과 같아야 한다.
CTF_IMAGE_NAMESPACE=xtkww971

# 참가자에게 안내할 CTF 서버 주소 (EC2 Elastic IP 또는 도메인). pwn은 nc <이 값> <포트>로 붙는다.
CTF_PUBLIC_HOST=

# 보안 그룹 인바운드와 같은 범위여야 한다 (RB-0001 단계 6).
CTF_PWN_PORT_RANGE=30000-30199

# 웹 백엔드(Lightsail)의 nimda-redis. 다른 호스트라 주소:포트로 적는다.
WEB_REDIS_ADDR=172.26.5.231:6379
WEB_REDIS_PASSWORD=
WEB_REDIS_DB=0

# web 인스턴스 게이트웨이를 바인딩할 EC2 사설 IP (ADR-0023, RB-0003). 포트는 8088 고정.
# 웹 backend의 CTF_INSTANCE_GATEWAY=<이 값>:8088 과 짝이다.
CTF_GATEWAY_BIND=172.31.47.34

# 문제 파일 S3 (웹 백엔드와 같은 버킷)
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET=nimda-website
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=

# "" = 기본 런타임, gVisor 설치 후 runsc
CTF_CONTAINER_RUNTIME=

LOG_LEVEL=info
