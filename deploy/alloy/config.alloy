// CTF EC2의 수집기 설정 (ADR-0024). 로그는 Loki로, 메트릭은 Prometheus로 push한다.
//
// 이 파일만 바꾸면 compose는 컨테이너를 다시 만들지 않는다. deploy.sh가 배포 때마다 alloy를 재시작해
// 새 설정을 읽게 한다. 문법 검사는 로컬에서 한다:
//   docker run --rm -v "$PWD/deploy/alloy:/etc/alloy:ro" grafana/alloy:v1.10.2 fmt /etc/alloy/config.alloy
//
// Docker API는 docker.sock이 아니라 docker-proxy를 거친다. 프록시는 조회(GET)만 연다(ADR-0009, ADR-0024).

// ============================================================ 로그

discovery.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  refresh_interval = "10s"
}

discovery.relabel "containers" {
  targets = []

  // /ctf-agent → ctf-agent
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // compose 서비스 이름(agent, provisioner, instance-gateway ...)
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  // 우리가 띄운 서비스와 agent가 띄운 문제 컨테이너를 나눈다.
  // 문제 컨테이너는 compose 라벨이 없고 agent가 nimda.ctf=1 라벨을 붙인다(runtime.containerLabels).
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = ".+"
    target_label  = "kind"
    replacement   = "system"
  }
  rule {
    source_labels = ["__meta_docker_container_label_nimda_ctf"]
    regex         = "1"
    target_label  = "kind"
    replacement   = "challenge"
  }
}

loki.source.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.containers.rules
  refresh_interval = "10s"
  forward_to       = [loki.process.containers.receiver]
}

loki.process "containers" {
  // 문제 컨테이너의 출력은 참가자가 정한다. 무한 출력으로 Loki를 채우지 못하게 컨테이너마다 자른다.
  // 넘친 줄은 버린다(drop). Loki의 per_stream_rate_limit이 한 번 더 막는다.
  stage.match {
    selector = "{kind=\"challenge\"}"

    stage.limit {
      rate          = 20
      burst         = 200
      by_label_name = "container"
      drop          = true
    }
  }

  // agent·provisioner·dashboard는 slog JSON 한 줄을 찍는다. level만 라벨로 올린다.
  // 나머지 필드(msg, uuid, error ...)는 라벨로 만들지 않는다. 라벨 값이 많아지면 Loki 색인이 커진다.
  // 조회할 때 LogQL의 `| json`으로 꺼낸다.
  stage.match {
    selector = "{service=~\"agent|provisioner|dashboard\"}"

    stage.json {
      expressions = { level = "level" }
    }

    stage.labels {
      values = { level = "" }
    }
  }

  // docker-proxy의 접근 로그는 Alloy가 10초마다 부르는 정상 요청(200)이 대부분이다. 그건 버리고
  // 거부(403)·오류만 남긴다. 403이 보이면 누군가 허용하지 않은 Docker API를 부른 것이다.
  stage.match {
    selector = "{service=\"docker-proxy\"}"

    stage.drop {
      expression = " 200 [0-9]+ "
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("MONITORING_LOKI_URL")
  }
  external_labels = { host = sys.env("MONITORING_HOST_LABEL") }
}

// ============================================================ 메트릭

// 호스트 CPU·메모리·디스크·네트워크. 호스트의 /proc, /sys, / 를 읽기 전용으로 받는다(compose volumes).
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/root"

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|pstore|securityfs|squashfs|sysfs|tmpfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run|sys|var/lib/docker/.+)($|/)"
  }

  // 컨테이너마다 생기는 veth·브리지는 뺀다. 문제 컨테이너 수만큼 시계열이 늘어난다.
  netclass {
    ignored_devices = "^(veth.*|br-.*|docker0|lo)$"
  }

  netdev {
    device_exclude = "^(veth.*|br-.*|docker0|lo)$"
  }
}

// 컨테이너별 CPU·메모리·네트워크. 문제 컨테이너도 포함된다.
//
// cAdvisor의 docker 연동은 쓰지 않고 도커 cgroup을 raw로 읽는다. docker 연동은 도커 저장소가
// overlay2일 때만 동작하고, containerd 이미지 저장소(Docker 29부터 새로 설치하면 기본값)에서는
// containerd.sock을 요구한다. 그 소켓은 docker.sock과 같은 권한이라 주지 않는다(ADR-0024).
// 그래서 docker_host를 일부러 없는 경로로 둬 docker 연동을 끈다. 저장소 종류와 상관없이 똑같이 동작한다.
// 컨테이너 이름은 cAdvisor가 아니라 아래 ctf_container_info 대응표로 붙인다.
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///nonexistent.sock"
  docker_only      = false
  storage_duration = "2m"
  // cgroupfs 드라이버(/docker/<id>)와 systemd 드라이버(/system.slice/docker-<id>.scope) 둘 다.
  raw_cgroup_prefix_allowlist = ["/docker/", "/system.slice/docker-"]

  // 디스크 사용량 계산(du)은 무겁고 여기서 쓸 일이 없다.
  disabled_metrics = ["disk", "diskIO", "percpu", "process", "tcp", "udp", "referenced_memory", "hugetlb", "sched", "advtcp", "memory_numa", "cpu_topology", "resctrl", "cpuset"]
}

// 컨테이너 id → 이름·종류·인스턴스 uuid 대응표. ctf_container_info{container_id, container, kind, ...} 0
//
// 실제로 아무것도 긁지 않는다. discovery.docker가 찾은 컨테이너마다 닿지 않는 주소(127.0.0.1:1)를
// 대상으로 두면 Prometheus가 대상마다 만드는 up 시계열이 남는다. 그 라벨만 쓰고 이름을 바꾼다.
// 문제 컨테이너로 요청이 가지 않는다. 대시보드는 cAdvisor 시계열과 container_id로 조인한다:
//   rate(container_cpu_usage_seconds_total[1m]) * on(container_id) group_left(container, kind) (ctf_container_info == bool 0)
discovery.relabel "container_info" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_id"]
    regex         = "([0-9a-f]{12}).*"
    target_label  = "container_id"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = ".+"
    target_label  = "kind"
    replacement   = "system"
  }
  rule {
    source_labels = ["__meta_docker_container_label_nimda_ctf"]
    regex         = "1"
    target_label  = "kind"
    replacement   = "challenge"
  }
  rule {
    source_labels = ["__meta_docker_container_label_nimda_ctf_uuid"]
    target_label  = "instance_uuid"
  }
  // 컨테이너가 망·포트마다 대상으로 여러 번 나온다. 주소를 하나로 고정하면 라벨이 같아져 하나로 합쳐진다.
  rule {
    target_label = "__address__"
    replacement  = "127.0.0.1:1"
  }
}

prometheus.scrape "container_info" {
  targets         = discovery.relabel.container_info.output
  job_name        = "container_info"
  scrape_interval = "30s"
  scrape_timeout  = "1s"
  forward_to      = [prometheus.relabel.container_info.receiver]
}

prometheus.relabel "container_info" {
  rule {
    source_labels = ["__name__"]
    regex         = "up"
    target_label  = "__name__"
    replacement   = "ctf_container_info"
  }
  // scrape_duration_seconds 같은 나머지 합성 시계열은 버린다.
  rule {
    source_labels = ["__name__"]
    regex         = "ctf_container_info"
    action        = "keep"
  }
  rule {
    regex  = "instance|job"
    action = "labeldrop"
  }

  forward_to = [prometheus.remote_write.default.receiver]
}

// ctf-redis 메모리와 스트림 적체. 상태가 전부 여기 있고(maxmemory 80mb, noeviction) 차면 쓰기가 막힌다.
prometheus.exporter.redis "ctf" {
  redis_addr           = "ctf-redis:6379"
  check_single_streams = ["ctf:agent:ops", "ctf:agent:results"]
}

prometheus.exporter.self "alloy" { }

prometheus.scrape "exporters" {
  targets = array.concat(
    prometheus.exporter.unix.host.targets,
    prometheus.exporter.cadvisor.containers.targets,
    prometheus.exporter.redis.ctf.targets,
    prometheus.exporter.self.alloy.targets,
  )
  scrape_interval = "15s"
  forward_to      = [prometheus.relabel.containers.receiver]
}

// cAdvisor 시계열에 cgroup 경로에서 뽑은 짧은 container_id(12자, `docker ps`의 ID)를 붙인다.
prometheus.relabel "containers" {
  // 내장 exporter의 instance는 Alloy 컨테이너의 hostname이라 컨테이너를 다시 만들 때마다 바뀐다.
  // 그대로 두면 재배포마다 같은 지표가 새 시계열로 갈라진다.
  rule {
    source_labels = ["job"]
    regex         = "integrations/(unix|cadvisor|self)"
    target_label  = "instance"
    replacement   = "ctf-alloy"
  }
  rule {
    source_labels = ["id"]
    regex         = ".*(?:/docker/|/docker-)([0-9a-f]{12})[0-9a-f]{52}(?:\\.scope)?$"
    target_label  = "container_id"
  }

  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = sys.env("MONITORING_PROMETHEUS_URL")
  }
  external_labels = { host = sys.env("MONITORING_HOST_LABEL") }
}
