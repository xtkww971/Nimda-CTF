# Copy to .env for local development (gitignored - see ../.gitignore's *.env rule).
# .vscode/launch.json's "Debug Worker (local)" config loads this file automatically.

# Point at the isolated test Redis from scripts\redis-up.bat (port 6380),
# not the shared nimda-redis-dev container, so local debugging never
# touches data the web backend is also using.
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0

JUDGE_QUEUE_STREAM_KEY=judge:submissions
JUDGE_QUEUE_CONSUMER_GROUP=judge-workers
CONSUMER_NAME=local-debug

# debug | info | warn | error (default: info)
LOG_LEVEL=debug

# Uncomment to expose pprof at http://localhost:6060/debug/pprof/ while
# debugging. Never set this to a non-loopback address (0.0.0.0:...) -
# pprof exposes stack traces and memory contents with no auth.
# PPROF_ADDR=localhost:6060